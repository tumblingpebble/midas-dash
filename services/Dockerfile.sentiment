FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.hf_cache \
    HF_HUB_DISABLE_XET=1 \
    SETFIT_MODEL_DIR=/app/audit_logs/sentiment_audit/setfit_model_hpc_full

WORKDIR /app

RUN apt-get update && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    curl \
  && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip

COPY requirements.base.txt /app/requirements.base.txt
COPY requirements.sentiment.txt /app/requirements.sentiment.txt
COPY requirements.build.txt /app/requirements.build.txt
COPY requirements.build.lock.txt /app/requirements.build.lock.txt
COPY requirements.base.lock.txt /app/requirements.base.lock.txt
COPY requirements.sentiment.lock.txt /app/requirements.sentiment.lock.txt

RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r /app/requirements.build.lock.txt
RUN python -m pip install --no-cache-dir --require-hashes --no-build-isolation -r /app/requirements.sentiment.lock.txt

COPY services /app/services
COPY audit_logs/sentiment_audit/setfit_model_hpc_full /app/audit_logs/sentiment_audit/setfit_model_hpc_full

RUN python -c "from transformers import pipeline; pipeline('text-classification', model='ProsusAI/finbert'); print('FinBERT cached into image')"

RUN python -m pip check && python -m pip uninstall -y pip

ENV APP_MODULE=services.sentiment_api.app:app
ENV PORT=8080

CMD ["sh", "-c", "uvicorn \"$APP_MODULE\" --host 0.0.0.0 --port \"$PORT\""]
