    {
      "path": "authority/provisioner/midas_jose_migration_test.go",
      "exists": false,
      "before_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "after_sha256": "d62c6410455296497db7cf0c151c8be056d5542f0ad36d78edfec728290a5eb5",
      "edits": [
        {
          "offset": 0,
          "old": "",
          "new": "package provisioner\n\nimport (\n\t\"go.step.sm/crypto/jose\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// MIDAS backport regression: a valid signature must not bypass audience validation.\nfunc TestMIDASAzureWrongAudience(t *testing.T) {\n\tp, srv, err := generateAzureWithServer()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer srv.Close()\n\tfor _, audience := range []string{azureDefaultAudience, \"https://wrong-audience.invalid\", \"\"} {\n\t\ttoken, err := generateAzureToken(\"subject\", p.oidcConfig.Issuer, audience, p.TenantID, \"subscriptionID\", \"resourceGroup\", \"virtualMachine\", \"vm\", time.Now(), &p.keyStore.keySet.Keys[0])\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\t_, _, _, _, _, err = p.authorizeToken(token)\n\t\tif audience == azureDefaultAudience {\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t} else if err == nil || !strings.Contains(err.Error(), \"failed to validate azure token payload\") {\n\t\t\tt.Fatalf(\"wrong/empty audience not rejected at payload validation: %v\", err)\n\t\t}\n\t}\n}\n\nfunc TestMIDASAnyAudienceSemantics(t *testing.T) {\n\tfor _, tc := range []struct {\n\t\tname   string\n\t\tactual jose.Audience\n\t\tvalid  bool\n\t}{\n\t\t{\"match\", jose.Audience{\"expected\"}, true},\n\t\t{\"overlap\", jose.Audience{\"other\", \"expected\"}, true},\n\t\t{\"wrong\", jose.Audience{\"wrong\"}, false},\n\t\t{\"empty\", nil, false},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tclaims := jose.Claims{Audience: tc.actual}\n\t\t\terr := claims.Validate(jose.Expected{AnyAudience: jose.Audience{\"expected\"}})\n\t\t\tif (err == nil) != tc.valid {\n\t\t\t\tt.Fatalf(\"audience validation = %v, want valid %v\", err, tc.valid)\n\t\t\t}\n\t\t})\n\t}\n}\n"
        }
      ]
    },
